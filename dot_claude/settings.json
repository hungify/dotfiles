{
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"permissions": {
		"deny": [
			"Bash(rm -rf /)",
			"Bash(rm -rf /*)",
			"Bash(rm -rf ~)",
			"Bash(rm -rf ~/*)",
			"Bash(git reset --hard*)",
			"Bash(git clean -fd*)",
			"Bash(git branch -D*)",
			"Bash(git push origin --delete*)",
			"Bash(sudo rm -rf*)",
			"Bash(dd if=*)",
			"Bash(mkfs*)",
			"Bash(diskutil eraseDisk*)",
			"Bash(diskutil eraseVolume*)",
			"Bash(diskutil eraseAPFS*)",
			"Bash(docker system prune*)",
			"Bash(docker volume rm*)",
			"Bash(docker volume prune*)",
			"Bash(docker-compose down -v*)",
			"Bash(docker compose down -v*)",
			"Bash(crontab -r*)"
		]
	},
	"model": "sonnet",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Read|Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/protect-env-files.sh"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/protect-env-bash.sh"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
						"timeout": 5
					}
				]
			}
		]
	},
	"statusLine": {
		"type": "command",
		"command": "ccstatusline",
		"padding": 0,
		"refreshInterval": 10
	},
	"modelSettings": {
		"claude-opus-5-5": {
			"effortLevel": "high"
		}
	},
	"skipDangerousModePermissionPrompt": true,
	"theme": "dark",
	"agentPushNotifEnabled": true,
	"includeCoAuthoredBy": false
}
